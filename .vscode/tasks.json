{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FoodProof Fit: Start backend",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "api:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "FoodProof Fit: Start web app",
      "type": "npm",
      "script": "dev",
      "path": "web",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "FoodProof Fit: Run backend tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "tests",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "FoodProof Fit: Build web app",
      "type": "npm",
      "script": "build",
      "path": "web",
      "problemMatcher": []
    },
    {
      "label": "FoodProof Fit: Verify baseline",
      "dependsOrder": "parallel",
      "dependsOn": [
        "FoodProof Fit: Run backend tests",
        "FoodProof Fit: Build web app"
      ],
      "problemMatcher": []
    }
  ]
}
