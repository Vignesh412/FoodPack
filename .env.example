# Copy this file to .env and fill in real values. Never commit .env.
# Anthropic API key used for vision extraction and image-quality classification.
ANTHROPIC_API_KEY=

# Optional locally; required in cloud to protect paid API routes. Use the same
# long random value in the Python service and the hosted frontend environment.
FOODPROOF_API_TOKEN=

# Model name for vision calls. Override if your account uses a different alias.
FOODPROOF_VISION_MODEL=claude-sonnet-4-6

# Optional: Open Food Facts is a public, keyless API - no token needed.
# Left here in case the team switches to a rate-limited mirror.
OFF_API_BASE=https://world.openfoodfacts.org
OFF_SEARCH_API_URL=https://search.openfoodfacts.org/search
OFF_USER_AGENT=FoodProofFit/1.2 (https://github.com/Vignesh412/FoodPack)

# Comma-separated web origins permitted to call the production API.
FOODPROOF_ALLOWED_ORIGINS=http://localhost:3000
